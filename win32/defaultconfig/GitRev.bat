@echo off
rem ---------------------------------------------------------------------------
rem Generates win32\userconfig\gitrev.h from the HEAD commit hash.
rem This is the project's pre-build step: it reads .git directly instead of
rem running git.exe, so the build does not depend on Git being on PATH.
rem Without a .git directory the header defines no revision and the title bar
rem shows no hash.
rem ---------------------------------------------------------------------------
setlocal
pushd "%~dp0.."

set "OUT=userconfig\gitrev.h"
set "TMP=userconfig\gitrev.h.tmp"
set "GITDIR=..\.git"

if not exist "userconfig" mkdir "userconfig"

rem A linked worktree or submodule has a .git file pointing at the real
rem metadata directory.
if exist "%GITDIR%\HEAD" goto :HaveGitDir
if not exist "%GITDIR%" goto :NoGit
set "GITLINK="
set /p GITLINK=<"%GITDIR%"
if /i not "%GITLINK:~0,8%"=="gitdir: " goto :NoGit
set "GITDIR=%GITLINK:~8%"
if "%GITDIR:~1,1%"==":" goto :HaveGitDir
if "%GITDIR:~0,2%"=="\\" goto :HaveGitDir
rem The path in a .git file is relative to the directory holding that file.
set "GITDIR=..\%GITDIR%"

:HaveGitDir
if not exist "%GITDIR%\HEAD" goto :NoGit
set "HEAD="
set /p HEAD=<"%GITDIR%\HEAD"
if not defined HEAD goto :NoGit

rem A normal HEAD is "ref: refs/heads/<branch>"; a detached HEAD is the hash.
if /i not "%HEAD:~0,5%"=="ref: " goto :UseHead
set "REF=%HEAD:~5%"
set "REF=%REF:/=\%"
set "HASH="
if exist "%GITDIR%\%REF%" set /p HASH=<"%GITDIR%\%REF%"
if defined HASH goto :Shorten

rem Branches that have not moved since the clone are stored in packed-refs.
for /f "tokens=1,2" %%a in ('findstr /c:" %HEAD:~5%" "%GITDIR%\packed-refs" 2^>nul') do set "HASH=%%a"
if not defined HASH goto :NoGit
goto :Shorten

:UseHead
set "HASH=%HEAD%"

:Shorten
set "HASH=%HASH:~0,7%"
rem Only accept a real hexadecimal hash; anything else means no revision.
echo(%HASH%| findstr /r /c:"^[0-9a-f][0-9a-f]*$" >nul 2>&1
if errorlevel 1 goto :NoGit

>"%TMP%" echo // Generated by defaultconfig\GitRev.bat. Do not edit.
>>"%TMP%" echo #define VBA_HAVE_GIT_REV
>>"%TMP%" echo #define VBA_REV_STR "%HASH%"
goto :Compare

:NoGit
>"%TMP%" echo // Generated by defaultconfig\GitRev.bat. Do not edit.
>>"%TMP%" echo // No Git revision was found; no hash is shown.

:Compare
rem Only rewrite the header when it actually changes, so incremental builds do
rem not recompile everything just because the project was built again.
fc /b "%TMP%" "%OUT%" >nul 2>&1
if not errorlevel 1 goto :Keep
move /y "%TMP%" "%OUT%" >nul
goto :End

:Keep
del "%TMP%" >nul 2>&1

:End
popd
endlocal
